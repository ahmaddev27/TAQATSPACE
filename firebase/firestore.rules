rules_version = '2';

// TAQAT — Firestore security rules for the realtime chat (wave 2).
//
// Auth model: the SPA signs in with a Firebase **custom token** minted by the
// Laravel backend (POST /api/chat/token). The token's `uid` is our application
// user id, so `request.auth.uid` here equals that user's id. A conversation and
// its messages are readable/writable only by a user whose uid is one of the
// conversation's `participants`.
//
// Data model:
//   conversations/{convId}
//     { participants: [uidA, uidB], participantNames: { uid: name },
//       workspaceId, lastMessage, lastSenderId, updatedAt }
//   conversations/{convId}/messages/{msgId}
//     { senderId, text, createdAt }
//
// Deploy (from the repo root, with the Firebase CLI authenticated to the
// project that backs NEXT_PUBLIC_FIREBASE_PROJECT_ID):
//
//   firebase deploy --only firestore:rules --project <your-project-id>
//
// firebase.json should point `firestore.rules` at this file, e.g.:
//   { "firestore": { "rules": "firebase/firestore.rules" } }

service cloud.firestore {
  match /databases/{database}/documents {

    // True when the caller is signed in and is a participant of the conversation
    // document `conv` (a `data`/`resource.data` map with a `participants` list).
    function isParticipant(conv) {
      return request.auth != null
        && conv.participants is list
        && request.auth.uid in conv.participants;
    }

    match /conversations/{convId} {
      // Reads require existing membership.
      allow read: if isParticipant(resource.data);

      // On create, the author must include themselves in `participants`.
      allow create: if isParticipant(request.resource.data);

      // On update, the caller must be a participant both before and after, so a
      // user can never write themselves out of (or a stranger into) a thread.
      allow update: if isParticipant(resource.data)
        && isParticipant(request.resource.data);

      // Conversations are append-only history; deletion is not permitted.
      allow delete: if false;

      match /messages/{messageId} {
        // The PARENT conversation document — null until its first message
        // creates it. Membership is resolved against it.
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(convId));
        }
        function isParentParticipant() {
          return parentConversation() != null
            && isParticipant(parentConversation().data);
        }

        // A participant may read the thread. A not-yet-created conversation has
        // no messages, so allowing its (empty) read keeps the live listener
        // alive until the first message creates the parent — instead of erroring
        // on get(null).data and tearing the listener down (sent messages would
        // then never appear without a manual refresh).
        allow read: if request.auth != null
          && (parentConversation() == null || isParentParticipant());

        // Only a participant may post, and only as themselves (no spoofing the
        // `senderId`). Messages are immutable once written.
        allow create: if isParentParticipant()
          && request.resource.data.senderId == request.auth.uid;

        allow update, delete: if false;
      }
    }
  }
}
