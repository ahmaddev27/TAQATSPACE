NEXT_PUBLIC_API_URL=http://localhost:8000/api

# SSO single logout (client-side). When set, logging out also ends the Taqat SSO
# session by redirecting to this endpoint with the current origin as the
# post_logout_redirect_uri (so each environment returns to its own site — the
# origin must be registered at the IdP). Leave unset for a local-only logout.
# Set per environment at build time (NEXT_PUBLIC_* are baked into the build).
#   Staging: NEXT_PUBLIC_SSO_LOGOUT_URL=https://staging.sso.taqat.work/api/oidc/logout
NEXT_PUBLIC_SSO_LOGOUT_URL=
NEXT_PUBLIC_SSO_CLIENT_ID=taqat-space

# Maps use MapLibre + OpenFreeMap (https://openfreemap.org) — no API key needed.

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (web push) — OPTIONAL.
#
# Leave these blank to disable push entirely: the app builds and runs normally,
# and all Firebase code no-ops (the SDK is never even initialized). Fill them in
# (from Firebase Console → Project settings → Your apps → Web app) to enable
# browser push notifications. All six below are required together; the VAPID key
# is required for web push specifically (Cloud Messaging → Web Push certificates).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
